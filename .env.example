# =============================================================================
# Plantilla de variables de entorno
# Copia este archivo a `.env` (o ejecuta `make init`) y ajusta los valores.
# Nunca subas `.env` al repositorio.
# =============================================================================

# --- Identidad del proyecto --------------------------------------------------
COMPOSE_PROJECT_NAME=my-project
APP_ENV=development
TZ=UTC

# --- Ejecución y rotación de logs --------------------------------------------
RESTART_POLICY=unless-stopped
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

# --- Límites de recursos por defecto -----------------------------------------
DEFAULT_CPU_LIMIT=1.0
DEFAULT_MEM_LIMIT=512M
DEFAULT_CPU_RESERVATION=0.25
DEFAULT_MEM_RESERVATION=128M

# --- Healthchecks por defecto ------------------------------------------------
HEALTHCHECK_INTERVAL=30s
HEALTHCHECK_TIMEOUT=5s
HEALTHCHECK_RETRIES=3
HEALTHCHECK_START_PERIOD=15s

# --- Variables específicas de servicios --------------------------------------
# Añade aquí puertos, credenciales, etiquetas de imagen y configuración propia.
GID=1000
UID=1000

GRAFANA_IMAGE=grafana/grafana:latest
GRAFANA_PORT=3000

GF_ANALYTICS_ENABLED=false
GF_ANALYTICS_REPORTING_ENABLED=false
GF_CHECK_FOR_UPDATES=false
GF_CHECK_FOR_PLUGINS_UPDATES=false
GF_DEFAULT_INSTANCE_NAME=Grafana
GF_LOG_LEVEL=info
GF_LOG_MODE=console
GF_PATHS_CONFIG=/etc/grafana/grafana.ini
GF_PATHS_DATA=/var/lib/grafana
GF_PATHS_HOME=/usr/share/grafana
GF_PATHS_LOGS=/var/log/grafana
GF_PATHS_PLUGINS=/var/lib/grafana/plugins
GF_PATHS_PROVISIONING=/etc/grafana/provisioning
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
GF_SERVER_HTTP_ADDR=0.0.0.0
GF_SERVER_HTTP_PORT=3000
GF_SERVER_ROOT_URL=https://grafana.acampos.local
GF_SNAPSHOT_ENABLED=false
GF_ALLOW_ORG_CREATE=false
GF_USERS_ALLOW_SIGN_UP=false
GF_USERS_AUTO_ASSIGN_ORG_ROLE=Viewer
